# اسم النطاق الذي يُفتح منه النظام (يصدر له Caddy شهادة HTTPS وحده)
DOMAIN=eywaa.example.org
POSTGRES_PASSWORD=
# كل مفتاح:  openssl rand -base64 32      (JWT_SECRET:  openssl rand -hex 32)
JWT_SECRET=
FIELD_ENC_KEY=
FIELD_HMAC_KEY=
TOKEN_SIGNING_SEED=
# تنبيه: هذه المفاتيح لا تُبدَّل بعد أول تشغيل، ولا تُنسخ مع النسخ الاحتياطية في موضع واحد.
# ضياع FIELD_ENC_KEY يضيع به كل رقم وثيقة ومرفق؛ وتسرّب TOKEN_SIGNING_SEED يتيح تزوير رموز الاستلام.

# ---------- مزوّد الرسائل (اختياري) ----------
# ما دامت فارغة فالنظام على المحاكاة: يسجّل كل رسالة ولا يرسلها إلى أي هاتف.
# العنوان يستقبل:  POST  بترويسة Authorization: Bearer <الرمز>  وجسم {"channel":"SMS","to":"+9647...","text":"..."}
# ويجيب 2xx وفيه {"id":"..."}. و429 أو 5xx تُعاد بعدها المحاولة (دقيقة، خمس، ثلاثون)، وغيرها إخفاق نهائي.
# في واتساب يصل مع الطلب "imageUrl": رابط صورة رمز الاستلام (QR)، يرفقه المزوّد بالرسالة.
MSG_GATEWAY_URL=
MSG_GATEWAY_TOKEN=
# القنوات التي يخدمها المزوّد، بفواصل: SMS,WHATSAPP,VOICE
MSG_GATEWAY_CHANNELS=SMS
# أقصى ما يُرسل في الثانية. اجعله دون حدّ المزوّد.
MSG_RATE_PER_SEC=10
# سرّ يرسله المزوّد في ترويسة X-Gateway-Secret حين يُبلغ بالتسليم والقراءة على:
#   POST /api/notifications/provider-status   {"id":"...","status":"delivered|read|failed"}
MSG_CALLBACK_SECRET=
