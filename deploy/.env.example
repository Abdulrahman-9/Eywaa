# اسم النطاق الذي يُفتح منه النظام (يصدر له Caddy شهادة HTTPS وحده)
DOMAIN=eywaa.example.org
POSTGRES_PASSWORD=
# كل مفتاح:  openssl rand -base64 32      (JWT_SECRET:  openssl rand -hex 32)
JWT_SECRET=
FIELD_ENC_KEY=
FIELD_HMAC_KEY=
TOKEN_SIGNING_SEED=
# تنبيه: هذه المفاتيح لا تُبدَّل بعد أول تشغيل، ولا تُنسخ مع النسخ الاحتياطية في موضع واحد.
# ضياع FIELD_ENC_KEY يضيع به كل رقم وثيقة ومرفق؛ وتسرّب TOKEN_SIGNING_SEED يتيح تزوير رموز الاستلام.
